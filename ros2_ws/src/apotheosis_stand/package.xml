<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apotheosis_stand</name>
  <version>1.0.0</version>
  <description>
    Учебный ROS 2-стенд manipulator-лабораторных: та же 4-шарнирная рука,
    что в интерактивном ноутбуке, - вживую в ROS 2 (tf2, URDF, RANSAC,
    гомография, стерео, IK). Два режима: полный живой стенд и мост
    из ноутбука (TCP 8977).
  </description>
  <maintainer email="student@example.com">Robotics Labs</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
